# Neon pooled connection (host contains -pooler), used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon direct connection, used by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/neondb?sslmode=require"

# Long random string used to sign login tokens
JWT_SECRET="replace-with-a-long-random-string"

# Password given to the admin account when the database is first seeded
SEED_ADMIN_PASSWORD="choose-a-strong-password"

# API port, and the front-end origin allowed to call it
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
