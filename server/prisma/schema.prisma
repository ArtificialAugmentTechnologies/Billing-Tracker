generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum ClientType {
  COLLEGE
  COMPANY
  PARTNER
  INDIVIDUAL
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ON_HOLD
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BILLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum GstType {
  CGST_SGST
  IGST
}

enum DiscountType {
  PERCENT
  FLAT
}

enum PaymentMode {
  BANK_TRANSFER
  UPI
  CASH
  CHEQUE
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(STAFF)
  createdAt    DateTime   @default(now())
  auditLogs    AuditLog[]
}

/// Single row, always id 1.
model CompanySettings {
  id                     Int      @id @default(1)
  name                   String
  addressLine            String
  phone                  String
  email                  String
  website                String
  gstin                  String?
  bankAccountName        String?
  bankName               String?
  bankAccountNo          String?
  bankIfsc               String?
  upiId                  String?
  signatureUrl           String?
  invoicePrefix          String   @default("AAT/INV")
  nextInvoiceSeq         Int      @default(1)
  currentFY              String
  defaultTerms           String
  defaultPaymentTermDays Int      @default(10)
  gstEnabledDefault      Boolean  @default(false)
  updatedAt              DateTime @updatedAt
}

model Client {
  id            String     @id @default(uuid())
  name          String
  alias         String?
  type          ClientType
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  pin           String?
  contactPerson String?
  phone         String?
  email         String?
  gstin         String?
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  projects      Project[]
  invoices      Invoice[]

  @@index([name])
}

model Project {
  id            String        @id @default(uuid())
  clientId      String
  name          String
  refCode       String        @unique
  description   String?
  contractValue Decimal       @default(0) @db.Decimal(12, 2)
  startDate     DateTime?     @db.Date
  status        ProjectStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  milestones    Milestone[]
  invoices      Invoice[]

  @@index([clientId])
}

model Milestone {
  id            String          @id @default(uuid())
  projectId     String
  name          String
  plannedAmount Decimal         @default(0) @db.Decimal(12, 2)
  dueDate       DateTime?       @db.Date
  status        MilestoneStatus @default(PENDING)
  order         Int             @default(1)
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoices      Invoice[]

  @@index([projectId])
}

model Invoice {
  id              String            @id @default(uuid())
  invoiceNo       String            @unique
  clientId        String
  projectId       String?
  milestoneId     String?
  subtitle        String?
  invoiceDate     DateTime          @db.Date
  dueDate         DateTime          @db.Date
  paymentTermDays Int
  status          InvoiceStatus     @default(DRAFT)
  gstEnabled      Boolean           @default(false)
  gstType         GstType?
  gstRate         Decimal?          @db.Decimal(5, 2)
  subtotal        Decimal           @default(0) @db.Decimal(12, 2)
  discountTotal   Decimal           @default(0) @db.Decimal(12, 2)
  taxTotal        Decimal           @default(0) @db.Decimal(12, 2)
  total           Decimal           @default(0) @db.Decimal(12, 2)
  advanceTotal    Decimal           @default(0) @db.Decimal(12, 2)
  balanceDue      Decimal           @default(0) @db.Decimal(12, 2)
  amountInWords   String?
  terms           String?
  notes           String?
  ribbonText      String?
  pdfPath         String?
  finalizedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  client          Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project         Project?          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  milestone       Milestone?        @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  items           InvoiceItem[]
  discounts       InvoiceDiscount[]
  payments        Payment[]

  @@index([clientId])
  @@index([projectId])
  @@index([status])
  @@index([dueDate])
}

model InvoiceItem {
  id             String        @id @default(uuid())
  invoiceId      String
  order          Int
  title          String
  subDescription String?
  qty            Decimal       @db.Decimal(10, 2)
  rate           Decimal       @db.Decimal(12, 2)
  discountType   DiscountType?
  discountValue  Decimal?      @db.Decimal(12, 2)
  amount         Decimal       @db.Decimal(12, 2)
  invoice        Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model InvoiceDiscount {
  id             String       @id @default(uuid())
  invoiceId      String
  label          String
  type           DiscountType
  value          Decimal      @db.Decimal(12, 2)
  computedAmount Decimal      @db.Decimal(12, 2)
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id        String      @id @default(uuid())
  invoiceId String
  date      DateTime    @db.Date
  amount    Decimal     @db.Decimal(12, 2)
  mode      PaymentMode
  reference String?
  notes     String?
  isAdvance Boolean     @default(false)
  createdAt DateTime    @default(now())
  invoice   Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
}

model CatalogItem {
  id             String  @id @default(uuid())
  title          String  @unique
  subDescription String?
  defaultRate    Decimal @default(0) @db.Decimal(12, 2)
  category       String?
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  entity    String
  entityId  String
  action    String
  timestamp DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
}
